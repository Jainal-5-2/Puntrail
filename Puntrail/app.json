{
  "expo": {
    "name": "Puntrail",
    "slug": "puntrail",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "puntrail",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.puntrail.app"
    },
    "android": {
      "package": "com.puntrail.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 37,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeMavenRepository": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b33191a7-ecaa-4358-9a26-2793fd61aa78"
      }
    },
    "owner": "asbijays-team"
  }
}
